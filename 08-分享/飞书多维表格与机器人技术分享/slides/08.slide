<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1.6, fontFamily: 'Microsoft YaHei' }}>
            02 · 机器人到底是什么
        </Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.2, marginTop: 10, fontFamily: 'Microsoft YaHei' }}>
            同一件事，两种跑法，差别在「谁在等」
        </Text>
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 18 }} />
    </Box>

    {/* 中间分隔线 */}
    <Box style={{ position: 'absolute', left: 616, top: 176, width: 1, height: 412, background: '#E2E8F0' }} />

    {/* 左：以前 */}
    <Box style={{ position: 'absolute', left: 60, top: 176, width: 500, height: 412, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#CBD5E1' }} />
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1.4, fontFamily: 'Microsoft YaHei' }}>以前 · 走 WorkBuddy 通道</Text>
        </Box>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#475569', lineHeight: 1.3, marginTop: 14, fontFamily: 'Microsoft YaHei' }}>
            每条消息，开一个会话
        </Text>
        <Box style={{ flexDirection: 'column', gap: 10, marginTop: 22 }}>
            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>飞书云端 → 飞书连接器 → WorkBuddy 客户端</Text>
            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>每条消息起一个 agent 会话（cwd 在 Claw 目录）</Text>
            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>会话里跑脚本 → 结果推回飞书</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0' }} />
        <Box style={{ flexDirection: 'column', gap: 12, marginTop: 18 }}>
            {[
                '每条消息一次模型调用 —— 传 70 集就是 70 次',
                '任务绑在会话上，会话结束就断',
                '好处：没写过的活，说人话也能干',
            ].map((t, i) => (
                <Text key={i} style={{ fontSize: 18, color: '#475569', lineHeight: 1.6, fontFamily: 'Microsoft YaHei' }}>{t}</Text>
            ))}
        </Box>
    </Box>

    {/* 右：现在 */}
    <Box style={{ position: 'absolute', left: 660, top: 176, width: 560, height: 412, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1D4ED8' }} />
            <Text style={{ fontSize: 14, color: '#1D4ED8', letterSpacing: 1.4, fontFamily: 'Microsoft YaHei' }}>现在 · 独立应用 + 常驻进程</Text>
        </Box>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.3, marginTop: 14, fontFamily: 'Microsoft YaHei' }}>
            一个进程，等所有消息
        </Text>
        <Box style={{ flexDirection: 'column', gap: 10, marginTop: 22 }}>
            <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>飞书云端 → 应用长连接 → 常驻进程（这台 Mac）</Text>
            <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>3 秒回执 → 队列 → 子进程干活</Text>
            <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.7, fontFamily: 'Microsoft YaHei' }}>回消息 / 写表 / 传平台</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Box style={{ width: '100%', height: 1, background: '#DBEAFE' }} />
        <Box style={{ flexDirection: 'column', gap: 12, marginTop: 18 }}>
            {[
                '逻辑自己写、出错自己修，没人兜底',
                '命令得按格式发，不会再猜你的意思',
                '好处：不吃 token，回执快，能排队重试',
            ].map((t, i) => (
                <Text key={i} style={{ fontSize: 18, color: '#0B1F3A', lineHeight: 1.6, fontFamily: 'Microsoft YaHei' }}>{t}</Text>
            ))}
        </Box>
    </Box>

    {/* 底部结论 */}
    <Box style={{ position: 'absolute', left: 60, top: 606, width: 1160, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 4, height: 22, background: '#F97316', borderRadius: 2 }} />
        <Text style={{ fontSize: 20, color: '#0B1F3A', lineHeight: 1.5, fontFamily: 'Microsoft YaHei' }}>
            判断标准：<span style={{ color: '#F97316', fontWeight: 'bold' }}>形状固定的活写进代码</span>，形状不固定的活留给会话
        </Text>
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 60, top: 670, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>乌小河 · 技术分享</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>08 / 18</Text>
    </Box>
</Slide>
