<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1.6, fontFamily: 'Microsoft YaHei' }}>
            03 · 多维表格 × 机器人
        </Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.2, marginTop: 10, fontFamily: 'Microsoft YaHei' }}>
            现在真在跑的三件事
        </Text>
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 18 }} />
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 176, width: 1160, flexDirection: 'column' }}>
        {[
            {
                cmd: '/base',
                status: '在跑',
                hot: false,
                name: '一句话改表',
                desc: '发一句「把 70 集的素材生成进展改成已上传」，机器人拆出集数、字段、值（值认别名），定位记录再写字段 —— 省的是在 70 行里翻找你那一集。',
            },
            {
                cmd: '/tbpz',
                status: '在跑',
                hot: false,
                name: '批注回表',
                desc: '审片人写在分秒帧时间轴上的意见，按镜头同步到表格的对应记录；加一句「预览」就只读不写 —— 省的是边看片边抄。',
            },
            {
                cmd: 'card.action.trigger',
                status: '待订阅事件',
                hot: true,
                name: '审阅卡片',
                desc: '一审 → 上传 → 精剪 → 终审 → 定剪，阶段一变卡片就进项目群，点按钮直接改状态字段 —— 省的是有人问「这集到哪了」。',
            },
        ].map((r, i) => (
            <Box key={i} style={{ height: 130, flexDirection: 'row', borderBottom: '1px solid #E2E8F0', paddingTop: 18 }}>
                <Box style={{ width: 250, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1D4ED8', fontFamily: 'Consolas' }}>{r.cmd}</Text>
                    <Box style={{ flexDirection: 'row', marginTop: 10 }}>
                        <Box style={{
                            border: r.hot ? '1px solid #FDBA74' : '1px solid #DBEAFE',
                            background: r.hot ? '#FFF7ED' : '#F8FAFC',
                            borderRadius: 4, paddingTop: 3, paddingBottom: 3, paddingLeft: 8, paddingRight: 8,
                        }}>
                            <Text style={{ fontSize: 14, color: r.hot ? '#EA580C' : '#1D4ED8', fontFamily: 'Microsoft YaHei' }}>{r.status}</Text>
                        </Box>
                    </Box>
                </Box>
                <Box style={{ width: 890, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.3, fontFamily: 'Microsoft YaHei' }}>{r.name}</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6, marginTop: 8, fontFamily: 'Microsoft YaHei' }}>{r.desc}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* 底部结论 */}
    <Box style={{ position: 'absolute', left: 60, top: 594, width: 1160, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 4, height: 22, background: '#F97316', borderRadius: 2 }} />
        <Text style={{ fontSize: 20, color: '#0B1F3A', lineHeight: 1.5, fontFamily: 'Microsoft YaHei' }}>
            三件事的共同点：<span style={{ color: '#F97316', fontWeight: 'bold' }}>输入是确定的，输出是一条记录</span> —— 所以能写成代码，不用每次问模型
        </Text>
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 60, top: 670, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>乌小河 · 技术分享</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>13 / 18</Text>
    </Box>
</Slide>
