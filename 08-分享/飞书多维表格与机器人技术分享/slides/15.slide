        </Text>
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 18 }} />
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 176, width: 1160, height: 392, border: '1px solid #E2E8F0', borderRadius: 12, flexDirection: 'column' }}>
        <Box style={{ height: 42, flexDirection: 'row', alignItems: 'center', background: '#F8FAFC', borderTopLeftRadius: 12, borderTopRightRadius: 12, paddingLeft: 24, paddingRight: 24 }}>
            <Text style={{ fontSize: 14, color: '#64748B', width: 230, fontFamily: 'Microsoft YaHei' }}>坑</Text>
            <Text style={{ fontSize: 14, color: '#64748B', width: 430, fontFamily: 'Microsoft YaHei' }}>现象</Text>
            <Text style={{ fontSize: 14, color: '#64748B', width: 450, fontFamily: 'Microsoft YaHei' }}>解法</Text>
        </Box>
        {[
            ['长连接 3 秒超时', '飞书等不到响应就重推同一件事', '秒回 + 队列 + 按 message_id 去重'],
            ['事件独占', '同一应用两个消费者，事件随机分给一个', '卡片回调和消息拆到两个应用'],
            ['参数名不一样', '文档写 app_token，CLI 要 --base-token', 'wiki 链接先解包成真实 token 再查'],
            ['插件沙箱', 'axios / sharp / moment 装了也用不了', '只用 context.fetch 和原生 API'],
            ['拿不到 token', '发消息直接 401，日志里看不出原因', '声明 useTenantAccessToken: true'],
            ['进程被回收', 'nohup 和后台起的进程活不长', '终端里 ./start.sh，别用 nohup'],
        ].map((r, i) => (
            <Box key={i} style={{ height: 56, flexDirection: 'row', alignItems: 'center', borderBottom: '1px solid #EEF2F7', paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0B1F3A', width: 230, fontFamily: 'Microsoft YaHei' }}>{r[0]}</Text>
                <Text style={{ fontSize: 16, color: '#475569', width: 430, fontFamily: 'Microsoft YaHei' }}>{r[1]}</Text>
                <Text style={{ fontSize: 16, color: '#334155', width: 450, fontFamily: 'Microsoft YaHei' }}>{r[2]}</Text>
            </Box>
        ))}
    </Box>

