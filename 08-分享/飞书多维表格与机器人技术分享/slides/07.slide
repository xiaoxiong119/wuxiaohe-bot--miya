<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1.6, fontFamily: 'Microsoft YaHei' }}>
            02 · 机器人到底是什么
        </Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.2, marginTop: 10, fontFamily: 'Microsoft YaHei' }}>
            一条长连接，加这台 Mac 上的一个进程
        </Text>
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 18 }} />
    </Box>

    {/* 四段链路 */}
    <Box style={{ position: 'absolute', left: 60, top: 172, width: 1160 }}>
        <Box style={{ position: 'absolute', left: 245, top: 29, width: 1, height: 300, background: '#E2E8F0' }} />
        {[
            { name: '飞书云端', tag: 'EVENT PUSH', desc: 'im.message.receive_v1 通过 WebSocket 长连接推过来 —— 不需要公网 IP、域名，也不需要内网穿透。机器人连得上飞书就能收消息。' },
            { name: '常驻进程', tag: 'src/index.js', desc: '3 秒内先回一句「收到」，真正的活进队列 —— 飞书等不到响应就会重推同一条消息，所以还得按 message_id 去重，否则一条视频传两遍。' },
            { name: '干活的那段', tag: 'src/worker.js', desc: '下载 messageResource（单文件 ≤ 100 MB）→ 子进程用 bsk 驱动本机 Chrome 传分秒帧 → 或者直接调 bitable 接口改字段、读记录。' },
            { name: '回消息', tag: 'IM API', desc: '文件名 + 列表 N→N+1 + 项目链接。传完立刻回，不用再进平台确认 —— 这一步是整条链路唯一给人看的输出。' },
        ].map((s, i) => (
            <Box key={i} style={{ height: 100, flexDirection: 'row' }}>
                <Box style={{ width: 220, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.3, fontFamily: 'Microsoft YaHei' }}>{s.name}</Text>
                    <Text style={{ fontSize: 14, color: '#1D4ED8', letterSpacing: 0.8, marginTop: 6, fontFamily: 'Consolas' }}>{s.tag}</Text>
                </Box>
                <Box style={{ width: 60, position: 'relative' }}>
                    <Box style={{ position: 'absolute', left: 20, top: 11, width: 11, height: 11, borderRadius: 6, background: i === 2 ? '#F97316' : '#1D4ED8', border: '3px solid #FFFFFF' }} />
                </Box>
                <Box style={{ width: 880, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6, fontFamily: 'Microsoft YaHei' }}>{s.desc}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* 底部结论 */}
    <Box style={{ position: 'absolute', left: 60, top: 592, width: 1160, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 4, height: 22, background: '#F97316', borderRadius: 2 }} />
        <Text style={{ fontSize: 20, color: '#0B1F3A', lineHeight: 1.5, fontFamily: 'Microsoft YaHei' }}>
            所以没有公网、没有服务器也能跑；代价是<span style={{ color: '#F97316', fontWeight: 'bold' }}>这台机器不能关机</span> —— 能力上限就是这台机器的上限
        </Text>
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 60, top: 670, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>乌小河 · 技术分享</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>07 / 18</Text>
    </Box>
</Slide>
