<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1.6, fontFamily: 'Microsoft YaHei' }}>
            01 · 一件事，要过三道手
        </Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.2, marginTop: 10, fontFamily: 'Microsoft YaHei' }}>
            一条素材，要在三个地方各登记一次
        </Text>
        <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 18 }} />
    </Box>

    {/* 左侧：四步人工流程 */}
    <Box style={{ position: 'absolute', left: 60, top: 168, width: 700, height: 472, flexDirection: 'column', justifyContent: 'space-between' }}>
        {[
            { no: '01', name: '群里发片', desc: '粗剪「第 67 集」发进飞书群，顺手说一句「这版可以传了」—— 这句话就是全部的交接记录。' },
            { no: '02', name: '手动传分秒帧', desc: '打开浏览器、拖进项目文件夹，再把文件名改成 67.mp4 —— 平台按文件名显示，改错就找不到。' },
            { no: '03', name: '回表里登记', desc: '在 70 行记录里翻到第 67 集，点开「素材生成进展」改成已上传，别忘了改更新时间。' },
            { no: '04', name: '意见再抄一遍', desc: '审片人在时间轴上留的批注，人工一条条搬进表格备注 —— 搬漏了也没人发现。' },
        ].map((s, idx) => (
            <Box key={idx} style={{ flexDirection: 'row', gap: 18 }}>
                <Box style={{ width: 46, height: 46, borderRadius: 23, border: '1px solid #DBEAFE', background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1D4ED8', fontFamily: 'Microsoft YaHei' }}>{s.no}</Text>
                </Box>
                <Box style={{ flexDirection: 'column', width: 636 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B1F3A', lineHeight: 1.3, fontFamily: 'Microsoft YaHei' }}>{s.name}</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6, marginTop: 8, fontFamily: 'Microsoft YaHei' }}>{s.desc}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* 右侧：深色锚点卡 */}
    <Box style={{ position: 'absolute', left: 800, top: 168, width: 420, height: 472, background: '#0B1F3A', borderRadius: 12, padding: 32, flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#8FA3BD', letterSpacing: 1.4, fontFamily: 'Microsoft YaHei' }}>
            同一份信息 · 登记次数
        </Text>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 10 }}>
            <Text style={{ fontSize: 104, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1, fontFamily: 'Microsoft YaHei' }}>3</Text>
            <Text style={{ fontSize: 30, color: '#FFFFFF', marginLeft: 8, marginBottom: 8, fontFamily: 'Microsoft YaHei' }}>处</Text>
        </Box>
        <Box style={{ width: '100%', height: 1, background: 'rgba(255,255,255,0.16)', marginTop: 20 }} />
        <Box style={{ flexDirection: 'column', gap: 16, marginTop: 20 }}>
            {[
                '名字对不上 —— 随手叫「67最终版」，搜不到',
                '表格滞后 —— 传完了没登记，表里还写待上传',
                '意见散落 —— 批注留在分秒帧，表里看不到',
            ].map((t, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#F97316', marginTop: 11 }} />
                    <Text style={{ fontSize: 18, color: '#CBD5E1', lineHeight: 1.6, width: 320, fontFamily: 'Microsoft YaHei' }}>{t}</Text>
                </Box>
            ))}
        </Box>
        <Box style={{ flex: 1 }} />
        <Box style={{ width: 48, height: 4, borderRadius: 2, background: '#F97316' }} />
    </Box>
    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 60, top: 670, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>乌小河 · 技术分享</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: 'Microsoft YaHei' }}>04 / 18</Text>
    </Box>
</Slide>
